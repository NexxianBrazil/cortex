# Cortex — variáveis de ambiente (exemplo)
# Copie para .env e preencha os valores reais. NUNCA commite o .env.
# Chaves de API vêm SEMPRE daqui (ou do ambiente) — nunca de arquivo versionado.

# --- Runtime (Fase 2) — sobrescrevem o config.toml ---
# Provedor de LLM ativo: stub | claude | openai
# CORTEX_PROVIDER=stub
# Modelo do provedor ativo (vazio = padrão do provedor)
# CORTEX_MODELO=
# Teto de iterações do loop por turno
# CORTEX_MAX_ITERACOES=10
# Pasta com a formação da persona
# CORTEX_PERSONAS_DIR=./personas

# --- Memória (Fase 3) ---
# Classificador de relação: heuristic (default) | llm (SEAM da 3c)
# CORTEX_CLASSIFIER=heuristic
# Persistência: memory (default dev/CI) | graphiti (Kuzu embarcado)
# CORTEX_STORE=memory
# Arquivo do banco Kuzu (quando CORTEX_STORE=graphiti)
# CORTEX_KUZU_DB_PATH=./cortex_memory.kuzu

# --- Credenciais (sem valores reais aqui!) ---
# Para provider=claude (API Anthropic)
ANTHROPIC_API_KEY=

# Para provider=openai (OpenAI, Ollama, vLLM ou LLM interna)
OPENAI_API_KEY=
# Endpoint OpenAI-compat; troque para apontar para Ollama/vLLM/LLM interna,
# ex.: http://localhost:11434/v1 (Ollama). Padrão: https://api.openai.com/v1
# OPENAI_BASE_URL=

# Nível de log: DEBUG | INFO | WARNING | ERROR
# CORTEX_LOG_LEVEL=INFO

# --- Fases futuras (placeholders, ainda não utilizados) ---
# Fase 3: memória (Graphiti / banco de grafos)
# CORTEX_GRAPH_DB_URI=
# CORTEX_GRAPH_DB_USER=
# CORTEX_GRAPH_DB_PASSWORD=

# Fase 5: systems of record (SAP/SQL)
# CORTEX_SOR_DSN=

# Fase 6: control plane / mTLS
# CORTEX_CONTROLPLANE_URL=
# CORTEX_MTLS_CERT_PATH=
# CORTEX_MTLS_KEY_PATH=
# CORTEX_MTLS_CA_PATH=
