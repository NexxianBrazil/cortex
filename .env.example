# Cortex — variáveis de ambiente (exemplo)
# Copie para .env e preencha os valores reais. NUNCA commite o .env.

# Ambiente de execução: development | staging | production
CORTEX_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR
CORTEX_LOG_LEVEL=INFO

# Diretório dos arquivos de formação da persona (SOUL/AGENTS/USER)
CORTEX_PERSONAS_DIR=./personas

# --- Fases futuras (placeholders, ainda não utilizados) ---
# Fase 3: memória (Graphiti / banco de grafos)
# CORTEX_GRAPH_DB_URI=
# CORTEX_GRAPH_DB_USER=
# CORTEX_GRAPH_DB_PASSWORD=

# Fase 5: systems of record (SAP/SQL)
# CORTEX_SOR_DSN=

# Fase 6: control plane / mTLS
# CORTEX_CONTROLPLANE_URL=
# CORTEX_MTLS_CERT_PATH=
# CORTEX_MTLS_KEY_PATH=
# CORTEX_MTLS_CA_PATH=
